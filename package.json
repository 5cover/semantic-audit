{
  "name": "semantic-audit",
  "version": "1.0.0",
  "description": "Composable audit-then-apply workflows for semantic LLM review",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./tasks": {
      "types": "./dist/src/tasks/index.d.ts",
      "import": "./dist/src/tasks/index.js"
    },
    "./registry": {
      "types": "./dist/src/registry.d.ts",
      "import": "./dist/src/registry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test",
    "check": "pnpm run typecheck && pnpm run test",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run check && pnpm run build"
  },
  "keywords": [
    "llm",
    "ai",
    "semantic-audit",
    "lint",
    "prompt-engineering",
    "workflow",
    "tempalace"
  ],
  "author": "Scover",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5cover/semantic-audit.git"
  },
  "bugs": {
    "url": "https://github.com/5cover/semantic-audit/issues"
  },
  "homepage": "https://github.com/5cover/semantic-audit#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tempalace/core": "^0.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "trailingComma": "es5",
    "semi": false
  }
}
